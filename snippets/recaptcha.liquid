{% doc %}
  Renders a visible "I'm not a robot" checkbox. Shopify rejects Google reCAPTCHA v2
  on storefront forms, so this is a native required checkbox. Shopify's own hCaptcha
  still protects customer, contact, and comment forms.

  @param {string} [class] - Optional extra CSS class.

  @example
  {% render 'recaptcha' %}
{% enddoc %}

<div class="hmc-robot-check{% if class != blank %} {{ class }}{% endif %}">
  <label class="hmc-robot-check__label" for="HmcRobotCheck-{{ section.id }}-{{ form.id }}">
    <input
      id="HmcRobotCheck-{{ section.id }}-{{ form.id }}"
      class="hmc-robot-check__input"
      type="checkbox"
      required
    >
    <span class="hmc-robot-check__box" aria-hidden="true"></span>
    <span class="hmc-robot-check__text">{{ 'hmc.recaptcha.label' | t }}</span>
  </label>
</div>

{% stylesheet %}
  .hmc-robot-check {
    display: block;
    flex: 0 0 100%;
    width: 100%;
    margin-block: 1.2rem;
  }

  .hmc-robot-check__label {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    margin: 0;
    cursor: pointer;
    font-size: 1.5rem;
    line-height: 1.4;
    color: inherit;
  }

  .hmc-robot-check__input {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .hmc-robot-check__box {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    width: 2.2rem;
    height: 2.2rem;
    border: 2px solid currentColor;
    background: #fff;
    color: #0a0a0a;
  }

  .hmc-robot-check__input:checked + .hmc-robot-check__box::after {
    content: '';
    width: 0.7rem;
    height: 1.2rem;
    border: solid #0a0a0a;
    border-width: 0 2px 2px 0;
    transform: rotate(45deg) translateY(-0.1rem);
  }

  .hmc-robot-check__input:focus-visible + .hmc-robot-check__box {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  .newsletter-form .hmc-robot-check,
  .hmc-newsletter-form .hmc-robot-check {
    flex: 0 0 100%;
  }
{% endstylesheet %}
