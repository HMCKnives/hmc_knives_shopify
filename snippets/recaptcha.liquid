{% doc %}
  Renders a Google reCAPTCHA v2 checkbox. Submit is blocked in the browser until it is
  checked. Google token fields are stripped before POST so Shopify does not reject the form.

  @param {string} [site_key] - Optional site key. Defaults to settings.recaptcha_site_key.
  @param {string} [theme] - light or dark. Defaults to settings.recaptcha_theme.
  @param {string} [class] - Optional extra CSS class.

  @example
  {% render 'recaptcha', site_key: section.settings.recaptcha_site_key, theme: section.settings.recaptcha_theme %}
{% enddoc %}

{%- liquid
  assign current_site_key = site_key | default: settings.recaptcha_site_key
  if current_site_key == blank
    assign current_site_key = settings.recaptcha_site_key
  endif

  assign current_theme = theme | default: settings.recaptcha_theme
  if current_theme == blank or current_theme == 'auto'
    assign current_theme = 'light'
  endif
-%}

{%- if current_site_key != blank -%}
  <div
    class="hmc-recaptcha{% if class != blank %} {{ class }}{% endif %}"
    data-hmc-recaptcha
    data-sitekey="{{ current_site_key | escape }}"
    data-theme="{{ current_theme }}"
    data-error="{{ 'hmc.recaptcha.required' | t | escape }}"
  >
    <div class="g-recaptcha"></div>
    <p class="hmc-recaptcha__error" hidden role="alert"></p>
  </div>
{%- endif -%}

{% stylesheet %}
  .hmc-recaptcha {
    display: block;
    flex: 0 0 100%;
    width: 100%;
    min-width: 304px;
    min-height: 78px;
    margin-block: 1.2rem;
    overflow: visible;
  }

  .hmc-recaptcha .g-recaptcha,
  .hmc-recaptcha iframe {
    min-width: 304px;
    min-height: 78px;
  }

  .hmc-recaptcha__error {
    margin: 0.8rem 0 0;
    color: #c41e1e;
    font-size: 1.4rem;
  }

  .newsletter-form .hmc-recaptcha,
  .hmc-newsletter-form .hmc-recaptcha {
    flex: 0 0 100%;
  }
{% endstylesheet %}
