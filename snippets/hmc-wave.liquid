{% doc %}
  Renders an HMC section wave divider.

  @param {boolean} [flip] - Flip the simple wave vertically
  @param {string} [fill] - SVG fill color (default #fff)
  @param {string} [variant] - Wave style: simple (default), wobble, double, layered, rounded, mini, mirrored, cap

  @example
  {% render 'hmc-wave', variant: 'wobble', fill: '#f7f7f7' %}
  {% render 'hmc-wave', variant: 'layered', fill: '#f8f8f8' %}
{% enddoc %}

{%- liquid
  assign wave_fill = fill | default: '#fff'
  assign wave_variant = variant | default: 'simple'
  assign wave_class = 'hmc-wave hmc-wave--' | append: wave_variant
  if flip and wave_variant == 'simple'
    assign wave_class = wave_class | append: ' hmc-wave--flip'
  endif
-%}

<div
  class="{{ wave_class }}"
  aria-hidden="true"
>
  {%- case wave_variant -%}
    {%- when 'wobble' -%}
      <svg viewBox="0 0 1000 244" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
        <path
          fill="{{ wave_fill }}"
          d="M0.3-0.7h1000.8c1.1,0,2.1,0.9,2.1,2.1v7.1v0.6v79.1c0,0.3-0.1,0.7-0.2,1c-30.8,57.6-155.2,75.8-256.4,80.7c-82.4,4-163.4,21.7-240.7,50.4c-35.1,13-71.5,21.3-109.7,21.6c-1.7,0-3.5,0-5.3,0c0,0-299,3.7-392.4-232.5C-1.7,9.2-1.8,9-1.8,8.7l0-7.3C-1.8,0.3-0.9-0.7,0.3-0.7z"
        />
      </svg>
    {%- when 'double' -%}
      <svg viewBox="0 0 1000 154.9" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
        <path
          class="hmc-wave__lite"
          fill="{{ wave_fill }}"
          d="M1000,90.6c-60.3-52.9-150.8-69.7-226-41.2c-23.2,8.8-44.8,21.4-68.6,28.4c-35.2,10.4-72.9,7.8-109.3,2.7c-19.1-2.7-38.1-6.1-56.2-12.6c-33.4-12-62.1-39.8-95.8-51c-44.2-14.7-84-19-138.7-6.1c-45.4,10.7-103.6,66-175.1,60C72.8,66.1,0.5,0,0.5,0v151.9H1000V90.6z"
        />
        <path
          fill="{{ wave_fill }}"
          d="M1000,139.1C939.7,87,845.6,91.8,770.1,120.9c-59.9,23.1-92.4-21.6-173.7,0C499.9,146.6,474.7,66.4,412,52c-117.5-27-202.2,63.9-263.4,71.9C38.1,138.4,0,64,0,64v90.9h1000V139.1z"
        />
      </svg>
    {%- when 'layered' -%}
      <svg viewBox="0 0 1000 78" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
        <path
          fill="{{ wave_fill }}"
          d="M0,0v60c51.1-27,123.1-42,216-45c122-4,207.4,27.3,443,38c72.6,3.3,186.3-4.4,341-23V0H0z"
        />
        <path
          fill="{{ wave_fill }}"
          opacity="0.6"
          d="M1,1v60c23.1-17,81.1-27,174-30c122-4,169.4,32.3,405,43c72.6,3.3,213-11,421-43V1H1z"
        />
        <path
          fill="{{ wave_fill }}"
          opacity="0.2"
          d="M1,0v62c17.8-9,73.1-15,166-18c122-4,188,18,366,18c62,0,147.7-9,314-9c32.1,0,83.4,6,154,18V0H1z"
        />
      </svg>
    {%- when 'rounded' -%}
      <svg viewBox="0 0 1000 244" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
        <path
          fill="{{ wave_fill }}"
          d="M1000,244V110c-110.7,59-248,98.3-398,98.3C349.4,208.3,121.4,116.6,0,0v244H1000z"
        />
      </svg>
    {%- when 'mirrored' -%}
      <svg viewBox="0 0 1000 137" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
        <path
          fill="{{ wave_fill }}"
          d="m933.31,67.34c-.28,0-.56-.02-.84-.02H66.69C29.78,66.86,0,36.91,0,0v137h1000v-2.35c0-36.91-29.78-66.86-66.69-67.31Z"
        />
      </svg>
    {%- when 'cap' -%}
      <svg viewBox="0 0 1000 86.31" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
        <path
          fill="{{ wave_fill }}"
          d="M1000,62.31s-162-102-424-45c0,0-462,115.7-576,13.8v55.2H1000Z"
        />
      </svg>
    {%- when 'mini' -%}
      <svg viewBox="0 0 1000 194.9" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
        <path
          fill="{{ wave_fill }}"
          d="M1000,0c-3.8,3.1-13.5,11.2-33.1,29.3C940,54,916.2,49.9,899.7,60.2s-19.6,21.6-34.1,41.2s-26.9,20.6-48.6,34c-21.7,13.4-67.2,3.1-100.3-2.1c-33.1-5.1-62,2.1-89.9,8.2c-27.9,6.2-72.3,27.8-102.3,35c-30,7.2-47.5,3.1-103.4-5.1c-55.8-8.2-97.2-26.8-122-31.9c-24.8-5.1-46.5,0-73.4,4.1s-45.5-7.2-65.1-17.5s-50.6-55.6-68.2-71c-17.6-15.4-36.2-14.4-62-21.6c-18.3-5.1-27-16-30.5-22v183.4h1000V0z"
        />
      </svg>
    {%- else -%}
      <svg viewBox="0 0 1440 48" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
        <path
          d="M0,32 C240,48 480,16 720,32 C960,48 1200,16 1440,32 L1440,48 L0,48 Z"
          fill="{{ wave_fill }}"
        />
      </svg>
  {%- endcase -%}
</div>
