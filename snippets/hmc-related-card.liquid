{% doc %}
  Related-product card: square image, title, optional price, and a product-page CTA.

  @param {object} product - Product Liquid object (required)

  @example
  {% render 'hmc-related-card', product: recommendation %}
{% enddoc %}

{%- if product and product != empty -%}
  {%- liquid
    assign title_id = 'HmcRelatedTitle-' | append: product.id
    assign show_price = false
    if product.price > 0
      assign show_price = true
    endif

    assign button_label = 'hmc.product.view_product' | t
    assign button_accessible = 'hmc.product.view_product_label' | t: title: product.title
    if product.has_only_default_variant == false and product.available
      assign button_label = 'hmc.product.select_options' | t
      assign button_accessible = 'hmc.product.select_options_label' | t: title: product.title
    endif
  -%}

  <article class="hmc-related-card" aria-labelledby="{{ title_id }}">
    <a class="hmc-related-card__link" href="{{ product.url }}" aria-labelledby="{{ title_id }}">
      <div class="hmc-related-card__media">
        {%- if product.featured_media -%}
          {{
            product.featured_media
            | image_url: width: 600
            | image_tag:
              loading: 'lazy',
              alt: '',
              widths: '240, 360, 480, 600',
              sizes: '(min-width: 990px) 243px, (min-width: 750px) 45vw, 90vw',
              class: 'hmc-related-card__image'
          }}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'hmc-related-card__image hmc-related-card__placeholder' }}
        {%- endif -%}
      </div>

      <h3 id="{{ title_id }}" class="hmc-related-card__title">{{ product.title | escape }}</h3>

      {%- if show_price -%}
        <p class="hmc-related-card__price">{{ product.price | money }}</p>
      {%- endif -%}
    </a>

    <a
      class="hmc-related-card__button"
      href="{{ product.url }}"
      aria-label="{{ button_accessible | escape }}"
    >
      {{ button_label | escape }}
    </a>
  </article>
{%- endif -%}

{% stylesheet %}
  .hmc-related-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
    overflow-wrap: break-word;
    color: color-mix(in srgb, var(--hmc-black, #0a0a0a) 85%, transparent);
  }

  .hmc-related-card__link {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    width: 100%;
    min-width: 0;
    text-decoration: none;
    color: inherit;
  }

  .hmc-related-card__link:focus-visible,
  .hmc-related-card__button:focus-visible {
    outline: 2px solid var(--hmc-accent, #383224);
    outline-offset: 3px;
  }

  .hmc-related-card__media {
    width: 100%;
    aspect-ratio: 1;
    margin-bottom: 1.6rem;
    overflow: hidden;
    background: var(--hmc-offwhite, #f7f7f7);
  }

  .hmc-related-card__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hmc-related-card__title {
    margin: 0;
    font-size: 1.8rem;
    font-weight: 400;
    line-height: 1.3;
    color: var(--hmc-black, #0a0a0a);
  }

  .hmc-related-card__price {
    margin: 0;
    font-size: 1.4rem;
    font-weight: 400;
    line-height: 1.4;
    color: color-mix(in srgb, var(--hmc-black, #0a0a0a) 85%, transparent);
  }

  .hmc-related-card__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 0.9rem;
    padding: 1rem 2rem;
    border: 0;
    border-radius: 3px;
    background: rgba(228, 228, 228, 0.69);
    color: #525252;
    font-size: 1.8rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: normal;
    text-align: start;
    text-decoration: none;
  }

  .hmc-related-card__button:hover {
    background: rgb(228, 228, 228);
  }
{% endstylesheet %}
