{% comment %}
  Renders Cloudflare Turnstile CAPTCHA widget.
  Accepts:
  - site_key: {String} Optional custom site key. Defaults to settings.turnstile_site_key.
  - theme: {String} Optional theme ('auto', 'dark', 'light'). Defaults to section/theme setting.
  - class: {String} Optional extra CSS class.

  Usage:
  {% render 'turnstile', site_key: section.settings.turnstile_site_key, theme: section.settings.turnstile_theme %}
{% endcomment %}

{%- liquid
  assign current_site_key = site_key
  if current_site_key == blank
    assign current_site_key = settings.turnstile_site_key
  endif

  assign current_theme = theme
  if current_theme == blank
    assign current_theme = settings.turnstile_theme | default: 'auto'
  endif
-%}

{%- if current_site_key != blank -%}
  <div class="turnstile-wrapper{% if class != blank %} {{ class }}{% endif %}" style="margin: 1.2rem 0; width: 100%; min-height: 65px; display: flex; align-items: center;">
    <div
      class="cf-turnstile"
      data-sitekey="{{ current_site_key | escape }}"
      data-theme="{{ current_theme }}"
      data-size="normal"
      data-appearance="always"
    ></div>
  </div>
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
{%- endif -%}
