{%- liquid
  assign overlay_opacity_pct = section.settings.overlay_opacity | default: 85
  assign overlay_alpha = overlay_opacity_pct | times: 0.01
  assign overlay_color = section.settings.overlay_color | default: '#435656'
  assign overlay_start = '#000000' | color_modify: 'alpha', overlay_alpha
  assign overlay_end = overlay_color | color_modify: 'alpha', overlay_alpha
-%}

<section
  id="HmcValueProps-{{ section.id }}"
  class="hmc-value-props hmc-media-section section-{{ section.id }}-padding"
  style="
    --hmc-section-padding-top: {{ section.settings.padding_top }}px;
    --hmc-section-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  {%- if section.settings.show_wave_top -%}
    <div class="hmc-value-props__wave hmc-value-props__wave--top">
      {% render 'hmc-wave', variant: 'wobble', fill: '#f7f7f7' %}
    </div>
  {%- endif -%}

  <div class="hmc-value-props__bg" aria-hidden="true">
    {%- if section.settings.background_image != blank -%}
      {%- liquid
        assign value_props_bg_alt = section.settings.background_image.alt | default: section.settings.heading | escape
      -%}
      {{
        section.settings.background_image
        | image_url: width: 2400
        | image_tag:
          loading: 'lazy',
          alt: value_props_bg_alt,
          widths: '750, 1100, 1500, 2000, 2400',
          sizes: '100vw',
          class: 'hmc-value-props__bg-image'
      }}
    {%- else -%}
      <img
        src="{{ 'hmc-default-bg.png' | asset_url }}"
        alt=""
        loading="lazy"
        width="2048"
        height="2048"
        class="hmc-value-props__bg-image"
      >
    {%- endif -%}
    <div
      class="hmc-value-props__overlay"
      style="background: linear-gradient(91deg, {{ overlay_start }} 0%, {{ overlay_end }} 100%);"
    ></div>
  </div>

  <div class="hmc-media-section__inner hmc-value-props__inner hmc-page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="hmc-value-props__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <div class="hmc-value-props__featured">
      {%- if section.settings.featured_image != blank -%}
        {%- liquid
          assign featured_img_alt = section.settings.featured_image.alt | default: section.settings.heading | escape
        -%}
        {{
          section.settings.featured_image
          | image_url: width: 1600
          | image_tag:
            loading: 'lazy',
            alt: featured_img_alt,
            widths: '600, 900, 1200, 1600',
            sizes: '(min-width: 990px) 900px, 92vw',
            class: 'hmc-value-props__featured-image'
        }}
      {%- else -%}
        <img
          src="{{ 'hmc-value-props-knives.jpg' | asset_url }}"
          alt="{{ section.settings.heading | escape }}"
          loading="lazy"
          width="1200"
          height="820"
          class="hmc-value-props__featured-image"
        >
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="hmc-value-props__list">
        {%- for block in section.blocks -%}
          <div class="hmc-value-props__item" {{ block.shopify_attributes }}>
            {%- if block.settings.title != blank -%}
              <h3 class="hmc-value-props__item-title">{{ block.settings.title | escape }}</h3>
            {%- endif -%}

            {%- if block.settings.text != blank -%}
              <div class="hmc-value-props__item-text rte">
                {{ block.settings.text }}
              </div>
            {%- endif -%}

            {%- if block.settings.link_label != blank and block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" class="hmc-value-props__item-link">
                {{ block.settings.link_label | escape }}
              </a>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  {%- if section.settings.show_wave_bottom -%}
    <div class="hmc-value-props__wave hmc-value-props__wave--bottom">
      {% render 'hmc-wave', variant: 'double', fill: '#f8f8f8' %}
    </div>
  {%- endif -%}
</section>

{% stylesheet %}
  .hmc-value-props {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    color: #f8f8f8;
    background: #0a0a0a;
    padding-top: 0;
    padding-bottom: 0;
  }

  .hmc-value-props__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    background-color: #0a0a0a;
  }

  .hmc-value-props__bg-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hmc-value-props__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  .hmc-value-props__wave {
    position: absolute;
    left: 0;
    right: 0;
    z-index: 3;
    line-height: 0;
    pointer-events: none;
  }

  .hmc-value-props__wave--top {
    top: 0;
  }

  .hmc-value-props__wave--bottom {
    bottom: 0;
  }

  .hmc-value-props__inner {
    position: relative;
    z-index: 2;
    padding-top: calc(72px + var(--hmc-section-padding-top, 36px) * 0.75);
    padding-bottom: calc(64px + var(--hmc-section-padding-bottom, 36px) * 0.75);
  }

  @media screen and (min-width: 750px) {
    .hmc-value-props__inner {
      padding-top: calc(72px + var(--hmc-section-padding-top, 36px));
      padding-bottom: calc(64px + var(--hmc-section-padding-bottom, 36px));
    }
  }

  .hmc-value-props__heading {
    margin: 0 0 1.75rem;
    text-align: center;
    font-size: clamp(1.85rem, 3.5vw, 2.4rem);
    font-weight: 700;
    line-height: 1.25;
    color: #f8f8f8;
  }

  .hmc-value-props__featured {
    width: min(100%, 56rem);
    margin: 0 auto 2.25rem;
  }

  .hmc-value-props__featured-image {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 12px;
    object-fit: cover;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.45);
  }

  .hmc-value-props__list {
    display: grid;
    gap: 1.75rem;
    grid-template-columns: 1fr;
    width: 100%;
    max-width: 90rem;
    margin-inline: auto;
  }

  @media screen and (min-width: 750px) {
    .hmc-value-props__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2.5rem;
    }

    .hmc-value-props__heading {
      margin-bottom: 2rem;
      font-size: 2.6rem;
    }

    .hmc-value-props__featured {
      margin-bottom: 2.5rem;
    }

    .hmc-value-props__item-title {
      font-size: 1.85rem;
    }

    .hmc-value-props__item-text,
    .hmc-value-props__item-link {
      font-size: 1.55rem;
    }
  }

  .hmc-value-props__item {
    min-width: 0;
  }

  .hmc-value-props__item-title {
    margin: 0 0 0.65rem;
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.3;
    color: #f8f8f8;
  }

  .hmc-value-props__item-text {
    margin: 0;
    font-size: 1.2rem;
    line-height: 1.55;
    color: rgba(248, 248, 248, 0.92);
    overflow-wrap: break-word;
    min-width: 0;
  }

  .hmc-value-props__item-text p {
    margin: 0;
  }

  .hmc-value-props__item-text p + p {
    margin-top: 0.65rem;
  }

  .hmc-value-props__item-link {
    display: inline-block;
    margin-top: 0.65rem;
    font-size: 1.2rem;
    font-weight: 700;
    color: #f8f8f8;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .hmc-value-props__item-link:hover {
    opacity: 0.85;
  }

  .hmc-value-props__item-link:focus-visible {
    outline: 2px solid #f8f8f8;
    outline-offset: 2px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.hmc-value-props.name",
  "tag": "section",
  "class": "hmc-section hmc-section--value-props",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.hmc-value-props.settings.heading",
      "default": "What Exactly Do You Get When You Order"
    },
    {
      "type": "image_picker",
      "id": "featured_image",
      "label": "t:sections.hmc-value-props.settings.featured_image"
    },
    {
      "type": "header",
      "content": "t:sections.hmc.common.background.header"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:sections.hmc.common.background.background_image"
    },
    {
      "type": "paragraph",
      "content": "t:sections.hmc.common.background.background_image_info"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "t:sections.hmc.common.background.overlay_color",
      "default": "#435656"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "t:sections.hmc.common.background.overlay_opacity",
      "default": 85
    },
    {
      "type": "checkbox",
      "id": "show_wave_top",
      "label": "t:sections.hmc-value-props.settings.show_wave_top",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_wave_bottom",
      "label": "t:sections.hmc-value-props.settings.show_wave_bottom",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.hmc.common.padding.header"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.hmc.common.padding.padding_top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.hmc.common.padding.padding_bottom",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "prop",
      "name": "t:sections.hmc-value-props.blocks.prop.name",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.hmc-value-props.blocks.prop.settings.title",
          "default": "01 — Custom Designed Knife"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.hmc-value-props.blocks.prop.settings.text",
          "default": "<p>Custom designed knives by Jim Vandeveld. Become one of the few in the world to own one.</p>"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "t:sections.hmc-value-props.blocks.prop.settings.link_label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.hmc-value-props.blocks.prop.settings.link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.hmc-value-props.name",
      "blocks": [
        {
          "type": "prop",
          "settings": {
            "title": "01 — Custom Designed Knife",
            "text": "<p>Custom designed knives by Jim Vandeveld. Become one of the few in the world to own one.</p>"
          }
        },
        {
          "type": "prop",
          "settings": {
            "title": "02 — Lifetime Guarantee",
            "text": "<p>Since we're using the highest quality materials and the most stringent adherence to our manufacturing process, we are confident that our knives won't get damaged through normal use.</p>"
          }
        },
        {
          "type": "prop",
          "settings": {
            "title": "03 — World Class Customer Service",
            "text": "<p>I don't just build these knives and send them out the door — my name is on every single one. If something isn't right, or you need help, you're talking to me directly.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
