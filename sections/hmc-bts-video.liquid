{%- liquid
  assign video_id = section.settings.video_url.id
  assign video_type = section.settings.video_url.type

  if video_type == 'youtube'
    assign embed_src = 'https://www.youtube.com/embed/' | append: video_id | append: '?rel=0'
  elsif video_type == 'vimeo'
    assign embed_src = 'https://player.vimeo.com/video/' | append: video_id
  endif

  assign frame_width = section.settings.frame_width | default: 276
-%}

<section
  id="HmcBtsVideo-{{ section.id }}"
  class="hmc-bts-video section-{{ section.id }}-padding"
  style="
    --hmc-bts-frame-width: {{ frame_width }}px;
    --hmc-section-padding-top: {{ section.settings.padding_top }}px;
    --hmc-section-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="hmc-page-width hmc-bts-video__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="hmc-bts-video__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <div class="hmc-bts-video__frame hmc-bts-video__frame--{{ section.settings.orientation }}">
      {%- if embed_src -%}
        <iframe
          class="hmc-bts-video__media"
          src="{{ embed_src }}"
          title="{{ section.settings.heading | default: shop.name | escape }}"
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        ></iframe>
      {%- elsif section.settings.poster != blank -%}
        {{
          section.settings.poster
          | image_url: width: 900
          | image_tag:
            loading: 'lazy',
            alt: section.settings.heading,
            widths: '300, 450, 600, 900',
            sizes: '(min-width: 750px) 280px, 70vw',
            class: 'hmc-bts-video__media'
        }}
      {%- else -%}
        <div class="hmc-bts-video__media hmc-bts-video__media--placeholder">
          {{ 'hero-apparel-3' | placeholder_svg_tag: 'hmc-bts-video__placeholder-svg' }}
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- if section.settings.show_wave_bottom -%}
    <div class="hmc-bts-video__wave" aria-hidden="true">
      {% render 'hmc-wave', variant: 'mini', fill: section.settings.wave_color %}
    </div>
  {%- endif -%}
</section>

{% stylesheet %}
  .hmc-bts-video {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: rgba(52, 47, 35, 0.04);
    padding-top: calc(var(--hmc-section-padding-top, 36px) * 0.75);
    padding-bottom: calc(var(--hmc-section-padding-bottom, 36px) * 0.75);
  }

  @media screen and (min-width: 750px) {
    .hmc-bts-video {
      padding-top: var(--hmc-section-padding-top, 36px);
      padding-bottom: var(--hmc-section-padding-bottom, 36px);
    }
  }

  .hmc-bts-video__inner {
    position: relative;
    z-index: 1;
  }

  .hmc-bts-video__heading {
    margin: 0 0 4.1rem;
    text-align: center;
    font-size: 2.4rem;
    font-weight: 700;
    line-height: 1.4;
    text-transform: capitalize;
    color: #0c1115;
  }

  @media screen and (min-width: 750px) {
    .hmc-bts-video__heading {
      font-size: 2.8rem;
    }
  }

  /* Phone-style frame around the clip, as on the reference site */
  .hmc-bts-video__frame {
    width: min(var(--hmc-bts-frame-width, 276px), 82vw);
    margin: 0 auto;
    padding: 1px;
    border: 8.67px solid #000;
    border-radius: 30px;
    overflow: hidden;
    background: #000;
    box-shadow: 0 8px 12px rgba(0, 0, 0, 0.25);
  }

  /* Outer ratio keeps the video area at 9:16 inside the frame's border */
  .hmc-bts-video__frame--portrait {
    aspect-ratio: 276 / 476;
  }

  .hmc-bts-video__frame--landscape {
    aspect-ratio: 16 / 9;
  }

  .hmc-bts-video__media {
    width: 100%;
    height: 100%;
    display: block;
    border: 0;
    object-fit: cover;
  }

  .hmc-bts-video__media--placeholder {
    background: #1a1a1a;
  }

  .hmc-bts-video__placeholder-svg {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    fill: rgba(255, 255, 255, 0.25);
  }

  .hmc-bts-video__wave {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 0;
    line-height: 0;
    pointer-events: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.hmc-bts-video.name",
  "tag": "section",
  "class": "hmc-section hmc-section--bts-video",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.hmc-bts-video.settings.heading",
      "default": "Peek Behind The Scenes!"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "accept": ["youtube", "vimeo"],
      "label": "t:sections.hmc-bts-video.settings.video_url"
    },
    {
      "type": "image_picker",
      "id": "poster",
      "label": "t:sections.hmc-bts-video.settings.poster",
      "info": "t:sections.hmc-bts-video.settings.poster_info"
    },
    {
      "type": "select",
      "id": "orientation",
      "label": "t:sections.hmc-bts-video.settings.orientation",
      "options": [
        { "value": "portrait", "label": "t:sections.hmc-bts-video.settings.orientation_portrait" },
        { "value": "landscape", "label": "t:sections.hmc-bts-video.settings.orientation_landscape" }
      ],
      "default": "portrait"
    },
    {
      "type": "range",
      "id": "frame_width",
      "min": 200,
      "max": 400,
      "step": 2,
      "unit": "px",
      "label": "t:sections.hmc-bts-video.settings.frame_width",
      "default": 276
    },
    {
      "type": "header",
      "content": "t:sections.hmc.common.waves.header"
    },
    {
      "type": "checkbox",
      "id": "show_wave_bottom",
      "label": "t:sections.hmc.common.waves.show_wave_bottom",
      "default": true
    },
    {
      "type": "color",
      "id": "wave_color",
      "label": "t:sections.hmc.common.waves.wave_color",
      "info": "t:sections.hmc.common.waves.wave_color_info",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "t:sections.hmc.common.padding.header"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:sections.hmc.common.padding.padding_top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:sections.hmc.common.padding.padding_bottom",
      "default": 120
    }
  ],
  "presets": [
    {
      "name": "t:sections.hmc-bts-video.name"
    }
  ]
}
{% endschema %}
