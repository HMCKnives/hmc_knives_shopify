{%- liquid
  assign product_form_id = 'HmcProductForm-' | append: section.id
  assign selected_variant = product.selected_or_first_available_variant
  assign sticky_class = ''
  if section.settings.enable_sticky_info
    assign sticky_class = ' hmc-product__info--sticky'
  endif
  assign in_stock = selected_variant.available
  assign stock_badge_class = 'hmc-product__stock hmc-product__stock--out'
  if in_stock
    assign stock_badge_class = 'hmc-product__stock hmc-product__stock--in'
    assign stock_badge_text = 'hmc.general.in_stock' | t
  else
    assign stock_badge_text = 'hmc.general.out_of_stock' | t
  endif
  assign price_label = 'hmc.product.price_label' | t: price: selected_variant.price | money
-%}

{%- if section.settings.show_breadcrumbs -%}
  {% render 'hmc-breadcrumbs' %}
{%- endif -%}

<section
  id="HmcProduct-{{ section.id }}"
  class="hmc-product hmc-product--media-{{ section.settings.media_size }}"
  style="
    --hmc-section-padding-top: {{ section.settings.padding_top }}px;
    --hmc-section-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <hmc-product-section
    data-label-in-stock="{{ 'hmc.general.in_stock' | t | escape }}"
    data-label-out-of-stock="{{ 'hmc.general.out_of_stock' | t | escape }}"
    data-label-add-to-cart="{{ 'hmc.general.add_to_cart' | t | escape }}"
    data-label-sold-out="{{ 'hmc.general.sold_out_button' | t | escape }}"
    data-price-label="{{ 'hmc.product.price_label' | t: price: '[price]' | escape }}"
  >
    <div class="hmc-page-width">
      <div class="hmc-product__grid">
        <div class="hmc-product__media">
          {%- if product.media.size > 0 -%}
            <div
              class="hmc-product__featured"
              data-hmc-product-featured
              role="region"
              aria-label="{{ 'hmc.accessibility.product_media' | t }}"
            >
              {%- assign featured_media = product.selected_or_first_available_variant.featured_media | default: product.featured_media -%}
              {%- if featured_media -%}
                {%- liquid
                  assign img_alt = featured_media.alt | default: product.title | escape
                -%}
                {{
                  featured_media
                  | image_url: width: 1600
                  | image_tag:
                    loading: 'eager',
                    fetchpriority: 'high',
                    alt: img_alt,
                    widths: '400, 600, 800, 1000, 1200, 1600',
                    sizes: '(min-width: 990px) 50vw, 100vw',
                    class: 'hmc-product__featured-image',
                    data-hmc-product-featured-image: ''
                }}
              {%- endif -%}
            </div>

            {%- if product.media.size > 1 -%}
              <ul
                class="hmc-product__thumbs"
                role="list"
                data-hmc-product-thumbs
                aria-label="{{ 'hmc.accessibility.product_thumbnails' | t }}"
              >
                {%- for media in product.media -%}
                  {%- if media.media_type == 'image' -%}
                    <li>
                      <button
                        type="button"
                        class="hmc-product__thumb{% if media.id == featured_media.id %} hmc-product__thumb--active{% endif %}"
                        data-hmc-product-thumb
                        data-media-id="{{ media.id }}"
                        data-src="{{ media | image_url: width: 1600 }}"
                        data-srcset="{{ media | image_url: width: 400 }} 400w, {{ media | image_url: width: 800 }} 800w, {{ media | image_url: width: 1200 }} 1200w, {{ media | image_url: width: 1600 }} 1600w"
                        aria-label="{{ 'hmc.general.view_image' | t: index: forloop.index }}"
                        aria-pressed="{% if media.id == featured_media.id %}true{% else %}false{% endif %}"
                      >
                        {%- liquid
                          assign img_alt = media.alt | default: product.title | escape
                        -%}
                        {{
                          media
                          | image_url: width: 160
                          | image_tag:
                            loading: 'lazy',
                            alt: img_alt,
                            widths: '80, 120, 160',
                            sizes: '80px',
                            class: 'hmc-product__thumb-image'
                        }}
                      </button>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            {%- endif -%}
          {%- else -%}
            <div class="hmc-product__featured hmc-product__featured--placeholder">
              {{ 'product-apparel-2' | placeholder_svg_tag: 'hmc-product__placeholder' }}
            </div>
          {%- endif -%}
        </div>

        <div class="hmc-product__info{{ sticky_class }}">
          {%- if section.settings.show_vendor and product.vendor != blank -%}
            <p class="hmc-product__vendor">{{ product.vendor | escape }}</p>
          {%- endif -%}

          <h1 class="hmc-product__title">{{ product.title | escape }}</h1>

          <div
            class="hmc-product__price"
            data-hmc-product-price
            aria-label="{{ price_label }}"
            {% if selected_variant.price <= 0 %}
              style="display: none;"
            {% endif %}
          >
            {%- if selected_variant.compare_at_price > selected_variant.price -%}
              <span class="hmc-product__price-compare" aria-hidden="true">{{ selected_variant.compare_at_price | money }}</span>
            {%- endif -%}
            <span class="hmc-product__price-current">{{ selected_variant.price | money }}</span>
          </div>

          {%- if section.settings.show_stock_badge -%}
            <p class="{{ stock_badge_class }}" data-hmc-product-stock>
              {{ stock_badge_text }}
            </p>
          {%- endif -%}

          <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
          <product-form>
            <div class="product-form__error-message-wrapper" role="alert" hidden>
              <span class="product-form__error-message"></span>
            </div>
            {%- form 'product', product, id: product_form_id, class: 'hmc-product__form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
            <input type="hidden" name="id" value="{{ selected_variant.id }}" data-hmc-product-variant-id>

            {%- unless product.has_only_default_variant -%}
              <div class="hmc-product__variants">
                {%- if product.options.size == 1 -%}
                  <label class="hmc-product__label" for="HmcVariantSelect-{{ section.id }}">
                    {{ product.options.first | escape }}
                  </label>
                  <select
                    id="HmcVariantSelect-{{ section.id }}"
                    class="hmc-product__select"
                    data-hmc-product-variant-select
                  >
                    {%- for variant in product.variants -%}
                      <option
                        value="{{ variant.id }}"
                        data-available="{{ variant.available }}"
                        data-price="{{ variant.price }}"
                        data-compare="{{ variant.compare_at_price }}"
                        {% if variant.id == selected_variant.id %}
                          selected
                        {% endif %}
                        {% unless variant.available %}
                          disabled
                        {% endunless %}
                      >
                        {{ variant.title | escape }}{% if variant.price > 0 %} — {{ variant.price | money }}{% endif %}
                      </option>
                    {%- endfor -%}
                  </select>
                {%- else -%}
                  {%- for option in product.options_with_values -%}
                    <div class="hmc-product__option">
                      <label class="hmc-product__label" for="HmcOption-{{ section.id }}-{{ forloop.index0 }}">
                        {{ option.name | escape }}
                      </label>
                      <select
                        id="HmcOption-{{ section.id }}-{{ forloop.index0 }}"
                        class="hmc-product__select"
                        data-hmc-product-option
                        data-option-index="{{ forloop.index0 }}"
                      >
                        {%- for value in option.values -%}
                          <option
                            value="{{ value | escape }}"
                            {% if option.selected_value == value %}
                              selected
                            {% endif %}
                          >
                            {{ value | escape }}
                          </option>
                        {%- endfor -%}
                      </select>
                    </div>
                  {%- endfor -%}
                {%- endif -%}
              </div>
            {%- endunless -%}

            <div class="hmc-product__quantity-row">
              <label class="hmc-product__label" for="HmcQuantity-{{ section.id }}">
                {{ 'hmc.general.quantity' | t }}
              </label>
              <input
                type="number"
                id="HmcQuantity-{{ section.id }}"
                class="hmc-product__quantity"
                name="quantity"
                min="1"
                value="1"
                inputmode="numeric"
              >
            </div>

            {%- if section.settings.show_notes_field -%}
              <div class="hmc-product__notes">
                <label class="hmc-product__label" for="HmcNotes-{{ section.id }}">
                  {{ 'hmc.general.notes' | t }}
                </label>
                <textarea
                  id="HmcNotes-{{ section.id }}"
                  class="hmc-product__notes-input"
                  name="properties[Notes]"
                  rows="3"
                  placeholder="{{ 'hmc.general.notes_placeholder' | t }}"
                ></textarea>
              </div>
            {%- endif -%}

            <button
              type="submit"
              name="add"
              class="hmc-btn hmc-btn--dark hmc-product__submit"
              data-hmc-product-submit
              {% unless selected_variant.available %}
                disabled
              {% endunless %}
            >
              <span>
                {%- if selected_variant.available -%}
                  {{ 'hmc.general.add_to_cart' | t }}
                {%- else -%}
                  {{ 'hmc.general.sold_out_button' | t }}
                {%- endif -%}
              </span>
              {%- render 'loading-spinner' -%}
            </button>
          {%- endform -%}
          </product-form>

          {%- for block in section.blocks -%}
            {%- if block.type == '@app' -%}
              <div class="hmc-product__app" {{ block.shopify_attributes }}>
                {% render block %}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      {%- if product.description != blank -%}
        <details class="hmc-product__description" open>
          <summary class="hmc-product__description-summary">{{ 'hmc.general.description' | t }}</summary>
          <div class="hmc-product__description-body rte">
            {{ product.description }}
          </div>
        </details>
      {%- endif -%}
    </div>

    <script type="application/json" data-hmc-product-json>
      {{ product.variants | json }}
    </script>
  </hmc-product-section>
</section>

{% stylesheet %}
  .hmc-product {
    background: var(--hmc-white, #fff);
    padding-top: calc(var(--hmc-section-padding-top, 36px) * 0.75);
    padding-bottom: calc(var(--hmc-section-padding-bottom, 36px) * 0.75);
  }

  @media screen and (min-width: 750px) {
    .hmc-product {
      padding-top: var(--hmc-section-padding-top, 36px);
      padding-bottom: var(--hmc-section-padding-bottom, 36px);
    }
  }

  .hmc-product__grid {
    display: grid;
    gap: 2rem;
    align-items: start;
  }

  @media screen and (min-width: 990px) {
    .hmc-product__grid {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }

    .hmc-product--media-small .hmc-product__grid {
      grid-template-columns: 0.9fr 1.1fr;
    }

    .hmc-product--media-large .hmc-product__grid {
      grid-template-columns: 1.15fr 0.85fr;
    }

    .hmc-product__info--sticky {
      position: sticky;
      top: 1.5rem;
    }
  }

  .hmc-product__featured {
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: var(--hmc-radius, 8px);
    background: var(--hmc-offwhite, #f7f7f7);
    box-shadow: var(--hmc-shadow, 0 4px 18px rgba(0, 0, 0, 0.08));
  }

  .hmc-product__featured-image,
  .hmc-product__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hmc-product__featured--placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hmc-product__thumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  .hmc-product__thumb {
    width: 4.5rem;
    height: 4.5rem;
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding: 0;
    border: 2px solid transparent;
    border-radius: var(--hmc-radius, 8px);
    overflow: hidden;
    background: var(--hmc-offwhite, #f7f7f7);
    cursor: pointer;
  }

  .hmc-product__thumb--active {
    border-color: var(--hmc-black, #0a0a0a);
  }

  .hmc-product__thumb:focus-visible {
    outline: 2px solid var(--hmc-black, #0a0a0a);
    outline-offset: 2px;
  }

  .hmc-product__thumb-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hmc-product__vendor {
    margin: 0 0 0.6rem;
    font-size: 1.4rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--hmc-muted, rgba(10, 10, 10, 0.75));
  }

  .hmc-product__title {
    margin: 0 0 1.2rem;
    font-size: clamp(2.4rem, 3vw, 2.88rem);
    font-weight: 700;
    line-height: 1.3;
    color: var(--hmc-black, #0a0a0a);
  }

  .hmc-product__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.8rem;
    margin-bottom: 1.2rem;
    font-size: 1.92rem;
    font-weight: 400;
    line-height: 1.75;
    color: var(--hmc-accent, #383224);
  }

  .hmc-product__price-compare {
    font-size: 1.6rem;
    font-weight: 400;
    text-decoration: line-through;
    color: var(--hmc-muted, rgba(10, 10, 10, 0.75));
  }

  .hmc-product__stock {
    margin: 0 0 1.6rem;
    font-size: 1.5rem;
    font-weight: 400;
    line-height: 1.75;
  }

  .hmc-product__stock--in {
    color: #1a7a3a;
  }

  .hmc-product__stock--out {
    color: var(--hmc-stock, #c41e1e);
  }

  .hmc-product__form {
    display: grid;
    gap: 1rem;
  }

  .hmc-product__label {
    display: block;
    margin-bottom: 0.6rem;
    font-size: 1.6rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--hmc-black, #0a0a0a);
  }

  .hmc-product__select,
  .hmc-product__quantity,
  .hmc-product__notes-input {
    width: 100%;
    min-height: 4.8rem;
    padding: 0.8rem 1.2rem;
    border: 1px solid rgba(0, 0, 0, 0.15);
    border-radius: var(--hmc-radius, 8px);
    font-size: 1.6rem;
    line-height: 1.4;
    color: var(--hmc-black, #0a0a0a);
    background: var(--hmc-white, #fff);
  }

  .hmc-product__select:focus-visible,
  .hmc-product__quantity:focus-visible,
  .hmc-product__notes-input:focus-visible,
  .hmc-product__submit:focus-visible {
    outline: 2px solid var(--hmc-black, #0a0a0a);
    outline-offset: 2px;
  }

  .hmc-product__notes-input {
    min-height: 88px;
    resize: vertical;
  }

  .hmc-product__quantity {
    max-width: 8rem;
  }

  .hmc-product__submit.hmc-btn {
    position: relative;
    width: 100%;
    min-height: 5.5rem;
    font-size: 1.6rem;
  }

  .hmc-product__submit .loading__spinner {
    position: absolute;
    inset: 0;
    display: none;
    align-items: center;
    justify-content: center;
  }

  .hmc-product__submit.loading .loading__spinner {
    display: flex;
  }

  .hmc-product__submit.loading > span {
    visibility: hidden;
  }

  .product-form__error-message-wrapper {
    margin: 0 0 1rem;
    color: var(--hmc-stock, #bb2121);
    font-size: 1.4rem;
  }

  .hmc-product__submit[disabled] {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .hmc-product__app {
    margin-top: 1.25rem;
  }

  .hmc-product__description {
    margin-top: 2.5rem;
    border-top: 1px solid rgba(0, 0, 0, 0.1);
  }

  .hmc-product__description-summary {
    padding: 1.2rem 0;
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 2.2rem;
    cursor: pointer;
    list-style: none;
    color: var(--hmc-black, #0a0a0a);
  }

  .hmc-product__description-summary:focus-visible {
    outline: 2px solid var(--hmc-black, #0a0a0a);
    outline-offset: 2px;
  }

  .hmc-product__description-summary::-webkit-details-marker {
    display: none;
  }

  .hmc-product__description-body {
    padding-bottom: 1.6rem;
    font-size: 1.4rem;
    font-weight: 400;
    line-height: 2.1rem;
    color: color-mix(in srgb, var(--hmc-black, #0a0a0a) 85%, transparent);
  }

  .hmc-product__description-body p {
    margin: 0 0 1.4rem;
  }

  .hmc-product__description-body h2,
  .hmc-product__description-body h3,
  .hmc-product__description-body h4,
  .hmc-product__description-body h5,
  .hmc-product__description-body h6 {
    margin: 1.6rem 0 0.8rem;
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 2.4rem;
    color: var(--hmc-black, #0a0a0a);
  }

  .hmc-product__description-body ul,
  .hmc-product__description-body ol {
    margin: 0 0 1.4rem;
    padding-inline-start: 2rem;
  }

  .hmc-product__description-body li {
    margin: 0 0 0.4rem;
  }
{% endstylesheet %}

{% javascript %}
  class HmcProductSection extends HTMLElement {
    #controller = null;

    connectedCallback() {
      this.#controller = new AbortController();
      const { signal } = this.#controller;

      const variants = JSON.parse(this.querySelector('[data-hmc-product-json]')?.textContent || '[]');
      const variantInput = this.querySelector('[data-hmc-product-variant-id]');
      const variantSelect = this.querySelector('[data-hmc-product-variant-select]');
      const optionSelects = this.querySelectorAll('[data-hmc-product-option]');
      const priceEl = this.querySelector('[data-hmc-product-price]');
      const stockEl = this.querySelector('[data-hmc-product-stock]');
      const submitBtn = this.querySelector('[data-hmc-product-submit]');
      const featuredImage = this.querySelector('[data-hmc-product-featured-image]');
      const thumbs = this.querySelectorAll('[data-hmc-product-thumb]');

      const labels = {
        inStock: this.dataset.labelInStock || 'In stock',
        outOfStock: this.dataset.labelOutOfStock || 'Out of stock',
        addToCart: this.dataset.labelAddToCart || 'Add to cart',
        soldOut: this.dataset.labelSoldOut || 'Sold out',
        priceLabel: this.dataset.priceLabel || 'Price: [price]'
      };

      const formatMoney = (cents) => {
        if (window.Shopify && typeof Shopify.formatMoney === 'function') {
          return Shopify.formatMoney(cents);
        }
        return `$${(cents / 100).toFixed(2)}`;
      };

      const findVariantByOptions = () => {
        const selected = Array.from(optionSelects).map((select) => select.value);
        return variants.find((variant) =>
          variant.options.every((option, index) => option === selected[index])
        );
      };

      const updateVariant = (variant) => {
        if (!variant || !variantInput) return;

        variantInput.value = variant.id;

        if (priceEl) {
          if (variant.price > 0) {
            priceEl.style.display = '';
            const formattedPrice = formatMoney(variant.price);
            const compare = variant.compare_at_price > variant.price
              ? `<span class="hmc-product__price-compare" aria-hidden="true">${formatMoney(variant.compare_at_price)}</span>`
              : '';
            priceEl.innerHTML = `${compare}<span class="hmc-product__price-current">${formattedPrice}</span>`;
            priceEl.setAttribute('aria-label', labels.priceLabel.replace('[price]', formattedPrice));
          } else {
            priceEl.style.display = 'none';
          }
        }

        if (stockEl) {
          stockEl.textContent = variant.available ? labels.inStock : labels.outOfStock;
          stockEl.classList.toggle('hmc-product__stock--in', variant.available);
          stockEl.classList.toggle('hmc-product__stock--out', !variant.available);
        }

        if (submitBtn) {
          submitBtn.disabled = !variant.available;
          const submitLabel = submitBtn.querySelector('span') || submitBtn;
          submitLabel.textContent = variant.available ? labels.addToCart : labels.soldOut;
        }
      };

      if (priceEl) {
        const checkPriceVisibility = () => {
          const currentPriceSpan = priceEl.querySelector('.hmc-product__price-current') || priceEl;
          const text = currentPriceSpan.textContent || '';
          const numericMatch = text.replace(/[^0-9.]/g, '');
          const priceValue = parseFloat(numericMatch);
          if (isNaN(priceValue) || priceValue <= 0) {
            priceEl.style.display = 'none';
          } else {
            priceEl.style.display = '';
          }
        };

        const priceObserver = new MutationObserver(() => {
          checkPriceVisibility();
        });
        priceObserver.observe(priceEl, { childList: true, subtree: true, characterData: true });
        signal.addEventListener('abort', () => priceObserver.disconnect());
      }

      if (variantSelect) {
        variantSelect.addEventListener('change', () => {
          const variant = variants.find((item) => String(item.id) === variantSelect.value);
          updateVariant(variant);
        }, { signal });
      }

      for (const select of optionSelects) {
        select.addEventListener('change', () => {
          updateVariant(findVariantByOptions());
        }, { signal });
      }

      for (const thumb of thumbs) {
        thumb.addEventListener('click', () => {
          if (!featuredImage) return;

          featuredImage.src = thumb.dataset.src;
          if (thumb.dataset.srcset) {
            featuredImage.srcset = thumb.dataset.srcset;
          }

          for (const button of thumbs) {
            const isActive = button === thumb;
            button.classList.toggle('hmc-product__thumb--active', isActive);
            button.setAttribute('aria-pressed', isActive ? 'true' : 'false');
          }
        }, { signal });
      }
    }

    disconnectedCallback() {
      this.#controller?.abort();
    }
  }

  if (!customElements.get('hmc-product-section')) {
    customElements.define('hmc-product-section', HmcProductSection);
  }
{% endjavascript %}

{% schema %}
{
  "name": "t:sections.hmc-product.name",
  "tag": "section",
  "class": "hmc-section hmc-section--product",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "t:sections.hmc-product.settings.show_breadcrumbs",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_stock_badge",
      "label": "t:sections.hmc-product.settings.show_stock_badge",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "t:sections.hmc-product.settings.show_vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_notes_field",
      "label": "t:sections.hmc-product.settings.show_notes_field",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_info",
      "label": "t:sections.hmc-product.settings.enable_sticky_info",
      "default": true
    },
    {
      "type": "select",
      "id": "media_size",
      "label": "t:sections.hmc-product.settings.media_size",
